<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mantiq_background"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="32dp"
        android:paddingEnd="24dp"
        android:paddingBottom="32dp">

        <ImageView
            android:layout_width="92dp"
            android:layout_height="92dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_launcher_foreground" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/welcome_title"
            android:textColor="@color/mantiq_accent"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/welcome_body"
            android:textColor="@color/mantiq_text"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/info_panel_background"
            android:padding="14dp"
            android:text="@string/system_settings_explanation"
            android:textColor="@color/mantiq_text_secondary"
            android:textSize="14sp" />

        <Button
            android:id="@+id/enable_keyboard_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/mantiq_accent"
            android:text="@string/enable_keyboard"
            android:textAllCaps="false"
            android:textColor="@color/mantiq_button_text" />

        <Button
            android:id="@+id/choose_keyboard_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/mantiq_surface_high"
            android:text="@string/choose_keyboard"
            android:textAllCaps="false"
            android:textColor="@color/mantiq_text" />

        <TextView
            android:id="@+id/keyboard_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="@string/status_unknown"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/keyboard_status_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:textColor="@color/mantiq_text_secondary"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/keyboard_test_field"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/test_field_background"
            android:gravity="start|top"
            android:hint="@string/test_keyboard"
            android:importantForAutofill="noExcludeDescendants"
            android:inputType="textMultiLine|textCapSentences"
            android:focusableInTouchMode="true"
            android:minHeight="88dp"
            android:padding="14dp"
            android:textColor="@color/mantiq_text"
            android:textColorHint="@color/mantiq_text_muted"
            android:textSize="17sp" />

        <Button
            android:id="@+id/open_keyboard_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:backgroundTint="@color/mantiq_accent"
            android:text="@string/open_keyboard"
            android:textAllCaps="false"
            android:textColor="@color/mantiq_button_text" />

        <Button
            android:id="@+id/copy_diagnostics_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:backgroundTint="@color/mantiq_surface_high"
            android:text="@string/copy_diagnostics"
            android:textAllCaps="false"
            android:textColor="@color/mantiq_text_secondary" />

    </LinearLayout>
</ScrollView>
